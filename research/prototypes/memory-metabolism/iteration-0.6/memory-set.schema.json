{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ena/research/memory-metabolism/iteration-0.6/memory-set.schema.json",
  "title": "ENA Memory Metabolism Research Memory Set iteration 0.6",
  "type": "object",
  "required": ["schema_version", "records", "provenance_sets", "projections"],
  "properties": {
    "schema_version": {"const": "memory-metabolism-research-0.6"},
    "provenance_sets": {"type": "array", "items": {"$ref": "#/$defs/provenance_set"}},
    "records": {"type": "array", "items": {"$ref": "#/$defs/memory_record"}},
    "projections": {"type": "array", "items": {"$ref": "#/$defs/decision_projection"}}
  },
  "additionalProperties": false,
  "$defs": {
    "validity": {"type": "object", "required": ["mode", "revalidate_before_material_use"], "properties": {
      "mode": {"enum": ["IMMUTABLE_OCCURRENCE", "CURRENT_STATE", "CONDITIONAL", "HISTORICAL", "UNKNOWN"]},
      "revalidate_before_material_use": {"type": "boolean"},
      "conditions": {"type": "array", "items": {"type": "string"}}
    }, "additionalProperties": false},
    "boundary_assertion": {"type": "object", "required": ["disposition"], "properties": {
      "disposition": {"enum": ["UNCHANGED", "CHANGED", "COMPOSED", "UNRESOLVED"]},
      "external_resolution_ref": {"type": "string", "minLength": 1},
      "notes": {"type": "string"}
    }, "additionalProperties": false},
    "record_resolution": {"type": "object", "required": ["record_id", "subject_fingerprint", "resolution_ref"], "properties": {
      "record_id": {"type": "string", "minLength": 1},
      "subject_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
      "resolution_ref": {"type": "string", "minLength": 1}
    }, "additionalProperties": false},
    "provenance_resolution": {"type": "object", "required": ["provenance_id", "subject_fingerprint", "resolution_ref"], "properties": {
      "provenance_id": {"type": "string", "minLength": 1},
      "subject_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
      "resolution_ref": {"type": "string", "minLength": 1}
    }, "additionalProperties": false},
    "provenance_set": {"type": "object", "required": ["provenance_id", "source_roots", "evidence_refs"], "properties": {
      "provenance_id": {"type": "string", "minLength": 1},
      "source_roots": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
      "evidence_refs": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
      "notes": {"type": "string"}
    }, "additionalProperties": false},
    "memory_record": {"type": "object", "required": ["record_id", "layer", "claim_type", "content", "source_roots", "validity"], "properties": {
      "record_id": {"type": "string", "minLength": 1},
      "layer": {"enum": ["OPERATIONAL", "EVIDENCE", "KNOWLEDGE", "COMPILED", "IDENTITY", "ARCHIVE"]},
      "claim_type": {"enum": ["OCCURRENCE", "OBSERVATION", "BELIEF", "HEURISTIC", "POLICY", "PREFERENCE", "TASK_STATE", "DECISION_RECORD", "AUTHORIZATION_OBSERVATION", "INDEX"]},
      "content": {"type": "string", "minLength": 1},
      "derived_from": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
      "evidence_refs": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
      "source_roots": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
      "provenance_ref": {"type": "string", "minLength": 1},
      "support_mode": {"enum": ["NONE", "SINGLE_SOURCE", "MULTI_SOURCE_DEPENDENT", "INDEPENDENT_CORROBORATION"]},
      "decision_material": {"type": "boolean"},
      "boundary_assertion": {"$ref": "#/$defs/boundary_assertion"},
      "evidence_status": {"enum": ["PRESENT", "LAWFULLY_REDACTED", "TOMBSTONE", "NOT_APPLICABLE"]},
      "evidence_availability": {"enum": ["ALL_PRESENT", "SOME_PRESENT", "NONE_PRESENT", "UNKNOWN"]},
      "authority_reference_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
      "validity": {"$ref": "#/$defs/validity"},
      "relations": {"type": "array", "items": {"type": "object", "required": ["type", "target"], "properties": {
        "type": {"enum": ["SUPPORTS", "CONTRADICTS", "AUTHORIZED_BY", "OBSERVED_IN", "FALSIFIED_BY"]},
        "target": {"type": "string", "minLength": 1}
      }, "additionalProperties": false}},
      "supersedes": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
      "conflict_handling": {"type": "string"},
      "mutation": {"type": "boolean"},
      "governance_ref": {"type": "string"},
      "notes": {"type": "string"}
    }, "additionalProperties": false},
    "decision_projection": {"type": "object", "required": ["projection_id", "security_mode", "visible_record_ids", "used_current_record_ids", "used_historical_record_ids", "revalidated_record_ids", "inspected_provenance_ids", "host_disclosure_resolutions", "host_boundary_resolutions", "host_provenance_resolutions", "consequence", "authority_required"], "properties": {
      "projection_id": {"type": "string", "minLength": 1},
      "security_mode": {"enum": ["SINGLE_BOUNDARY_REFERENCE", "HOST_RESOLVED_REFERENCE"]},
      "visible_record_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true, "description": "Actor-visible record content views. Internal retrieval candidates are outside this shared projection."},
      "used_current_record_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
      "used_historical_record_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
      "revalidated_record_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
      "inspected_provenance_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
      "host_disclosure_resolutions": {"type": "array", "items": {"$ref": "#/$defs/record_resolution"}},
      "host_boundary_resolutions": {"type": "array", "items": {"$ref": "#/$defs/record_resolution"}},
      "host_provenance_resolutions": {"type": "array", "items": {"$ref": "#/$defs/provenance_resolution"}},
      "consequence": {"enum": ["NON_MATERIAL", "MATERIAL"]},
      "authority_required": {"type": "boolean"},
      "external_authority_basis": {"type": "string"},
      "notes": {"type": "string"}
    }, "additionalProperties": false}
  }
}
