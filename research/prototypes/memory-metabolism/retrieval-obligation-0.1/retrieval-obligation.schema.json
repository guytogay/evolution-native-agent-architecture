{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ena/research/memory-metabolism/retrieval-obligation-0.1/schema.json",
  "title": "ENA Memory Metabolism Triggered Retrieval Obligation Research 0.1",
  "type": "object",
  "required": ["schema_version", "decisions", "trigger_events", "obligations", "attempts"],
  "properties": {
    "schema_version": {"const": "memory-retrieval-obligation-research-0.1"},
    "decisions": {"type": "array", "items": {"$ref": "#/$defs/decision"}},
    "trigger_events": {"type": "array", "items": {"$ref": "#/$defs/trigger"}},
    "obligations": {"type": "array", "items": {"$ref": "#/$defs/obligation"}},
    "attempts": {"type": "array", "items": {"$ref": "#/$defs/attempt"}}
  },
  "additionalProperties": false,
  "$defs": {
    "decision": {
      "type": "object",
      "required": ["decision_id", "consequence", "disposition", "uncertainty_declared"],
      "properties": {
        "decision_id": {"type": "string", "minLength": 1},
        "consequence": {"enum": ["NON_MATERIAL", "MATERIAL"]},
        "disposition": {"enum": ["READY", "PROCEED_UNCERTAIN", "NARROWED", "ABSTAINED"]},
        "uncertainty_declared": {"type": "boolean"},
        "notes": {"type": "string"}
      },
      "additionalProperties": false
    },
    "trigger": {
      "type": "object",
      "required": ["trigger_id", "decision_id", "basis", "resolver_ref"],
      "properties": {
        "trigger_id": {"type": "string", "minLength": 1},
        "decision_id": {"type": "string", "minLength": 1},
        "basis": {"enum": ["GENERIC_REFLEX", "HOST_SIGNAL", "EXPLICIT_USER", "KNOWN_GAP", "OTHER"]},
        "resolver_ref": {"type": "string", "minLength": 1},
        "notes": {"type": "string"}
      },
      "additionalProperties": false
    },
    "closure": {
      "type": "object",
      "required": ["disposition", "basis_attempt_id"],
      "properties": {
        "disposition": {"enum": ["RETRIEVAL_USED", "NO_HIT_BOUNDED", "UNCERTAIN_CONTINUATION", "CONSEQUENCE_NARROWED", "ABSTAINED"]},
        "basis_attempt_id": {"type": "string", "minLength": 1},
        "notes": {"type": "string"}
      },
      "additionalProperties": false
    },
    "obligation": {
      "type": "object",
      "required": ["obligation_id", "decision_id", "trigger_ids", "resolver_ref", "query_scope_ref", "state"],
      "properties": {
        "obligation_id": {"type": "string", "minLength": 1},
        "decision_id": {"type": "string", "minLength": 1},
        "trigger_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "resolver_ref": {"type": "string", "minLength": 1},
        "query_scope_ref": {"type": "string", "minLength": 1, "description": "Opaque resolver-declared search scope. A no-hit claim is bounded to this scope."},
        "state": {"enum": ["PENDING", "ATTEMPTED", "CLOSED"]},
        "closure": {"$ref": "#/$defs/closure"},
        "notes": {"type": "string"}
      },
      "additionalProperties": false
    },
    "attempt": {
      "type": "object",
      "required": ["attempt_id", "obligation_id", "sequence", "resolver_ref", "query_scope_ref", "outcome", "coverage", "returned_record_ids", "receipt_ref"],
      "properties": {
        "attempt_id": {"type": "string", "minLength": 1},
        "obligation_id": {"type": "string", "minLength": 1},
        "sequence": {"type": "integer", "minimum": 1},
        "resolver_ref": {"type": "string", "minLength": 1},
        "query_scope_ref": {"type": "string", "minLength": 1},
        "outcome": {"enum": ["HIT", "NO_HIT", "PARTIAL", "FAILED", "UNKNOWN"]},
        "coverage": {"enum": ["DECLARED_SCOPE_COMPLETE", "PARTIAL", "UNKNOWN"]},
        "returned_record_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "receipt_ref": {"type": "string", "minLength": 1},
        "notes": {"type": "string"}
      },
      "additionalProperties": false
    }
  }
}
